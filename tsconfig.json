{
    "compilerOptions": {
      "target": "es6",                          
      "module": "node16",  
      "declaration": true,
      "rootDir": ".",
      "outDir": "lib/mjs",                   
      "strict": false,
      "moduleResolution": "node16",
      "esModuleInterop": true,                  
      "forceConsistentCasingInFileNames": true  
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "lib"]                        
}
  